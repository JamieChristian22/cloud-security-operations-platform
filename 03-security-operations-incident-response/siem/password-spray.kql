// Sentinel SigninLogs example; validate schema and tune thresholds before activation.
// Fixed 10-minute bins differ from the Python rolling-window implementation.
let failures = SigninLogs
| where TimeGenerated > ago(1h) and ResultType != "0"
| summarize Users=make_set(UserPrincipalName), FirstFailure=min(TimeGenerated), LastFailure=max(TimeGenerated) by IPAddress, bin(TimeGenerated,10m)
| where array_length(Users) >= 3;
let successes = SigninLogs
| where TimeGenerated > ago(1h) and ResultType == "0"
| project IPAddress, SuccessTime=TimeGenerated, SuccessfulUser=UserPrincipalName;
failures
| join kind=leftouter successes on IPAddress
| extend CorrelatedSuccess=isnotnull(SuccessTime) and SuccessTime > LastFailure and SuccessTime <= LastFailure + 10m and set_has_element(Users, SuccessfulUser)
| summarize FirstFailure=min(FirstFailure), LastFailure=max(LastFailure), CorrelatedSuccesses=countif(CorrelatedSuccess), SuccessfulUsers=make_set_if(SuccessfulUser,CorrelatedSuccess) by IPAddress, TimeGenerated
